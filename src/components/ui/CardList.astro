---
type Props = { gap?: string; class?: string };
const { gap = "2rem", class: className } = Astro.props;
---

<ul class:list={["list", className]} style={`--card-gap: ${gap}`}>
  <slot />
</ul>

<style>
  .list {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
  }

  .list > :global(li)::before {
    content: none;
  }
</style>
