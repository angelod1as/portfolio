---
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<header class="page-header">
  <h1>{title}</h1>
  {description && <p>{description}</p>}
  <slot />
</header>

<style>
  .page-header > :global(* + *) {
    margin-top: 1rem;
  }

  p {
    font-style: italic;
  }
</style>
