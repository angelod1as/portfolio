---
type Facet = {
  name: string;
  label: string;
  values: readonly string[];
};

type Props = {
  facets: Facet[];
  target: string;
};

const { facets, target } = Astro.props;
---

{
  /* Rendered `hidden` on purpose: this is a static site, so a form submit
    would only reload an identical page. The script below reveals the
    controls, meaning no-JS visitors see the full list and no dead UI. */
}
<form class="filters" data-target={target} hidden>
  {
    facets.map((facet) => (
      <fieldset>
        <legend>{facet.label}</legend>
        {facet.values.map((value) => (
          <label>
            <input type="checkbox" name={facet.name} value={value} />
            {value}
          </label>
        ))}
      </fieldset>
    ))
  }
  <p class="count" aria-live="polite"></p>
</form>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
  }

  legend {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
  }

  .count {
    flex-basis: 100%;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  import { initFilters } from "./filters";

  initFilters();
</script>
