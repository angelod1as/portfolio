---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatCardDate } from "../utils/format-date";
import Card from "./Card.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

const { id, data } = Astro.props.project;

const {
  title,
  description,
  year: { from, to },
  what,
  how,
  thumb: { alt, src },
} = data;

const date = formatCardDate(from, to);
---

<Card url={id}>
  <div class="project">
    <Image src={src} alt={alt} />
    <div class="data">
      <h3 class="title">{title} <span class="year">{date}</span></h3>
      <p class="description">{description}</p>
      <div class="columns">
        <div>
          <p class="subtitle">What?</p>
          <ul>{what.map((item) => <li>{item}</li>)}</ul>
        </div>
        {
          how && (
            <div>
              <p class="subtitle">How?</p>
              <ul>
                {how.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Card>

<style>
  .project {
    gap: 1rem;
    display: grid;
    grid-template-columns: 1fr 6fr;
  }

  .data {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title {
    font-weight: bold;
    font-size: 1.5rem;
    margin: 0;
  }

  .description {
    margin-bottom: 1rem;
  }

  .year {
    padding-left: 1rem;
    font-weight: normal;
    font-size: 1rem;
  }

  .columns {
    display: flex;
    gap: 2rem;
  }

  .subtitle {
    font-weight: bold;
  }
</style>
