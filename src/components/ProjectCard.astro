---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatCardDate } from "../utils/format-date";
import Card from "./Card.astro";
import Pill from "./Pill.astro";

type Props = {
  project: CollectionEntry<"projects">;
  variant?: "full" | "compact";
};

const { project, variant = "full" } = Astro.props;
const { id, data } = project;

const { title, description, year, type, what, medium, thumb } = data;

const date = formatCardDate(year.from, year.to);
const tags = [...what, ...medium];
const full = variant === "full";
---

<Card url={`/projects/${id}`} label={`${title} - ${description}`}>
  <article class="project" data-variant={variant}>
    {full && <Image src={thumb.src} alt={thumb.alt} />}
    <div class="body">
      <p class="meta">{date} · {type}</p>
      <h3 class="title">{title}</h3>
      <p>{description}</p>
      {
        full && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <Pill variant="outline">{tag}</Pill>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</Card>

<style>
  .project {
    display: grid;
    gap: 1rem;
  }

  .project[data-variant="full"] {
    grid-template-columns: minmax(6rem, 1fr) 5fr;
  }

  .body > * + * {
    margin-top: 0.5rem;
  }

  .meta {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .title {
    margin: 0;
    font-size: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin-top: 1rem;
  }

  .tags li::before {
    content: none;
  }
</style>
