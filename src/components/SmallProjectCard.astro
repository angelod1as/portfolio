---
import type { CollectionEntry } from "astro:content";
import { formatCardDate } from "../utils/format-date";
import Card from "./Card.astro";

type Props = {
  project: CollectionEntry<"projects">;
};

const { id, data } = Astro.props.project;

const {
  title,
  description,
  year: { from, to },
} = data;

const date = formatCardDate(from, to);
---

<Card url={`projects/${id}`}>
  <p class="title">{title}</p>
  <p class="year">{date}</p>
  <p>{description}</p>
</Card>

<style>
  .project {
    gap: 1rem;
  }

  .data {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title {
    font-weight: bold;
    font-size: 1.5rem;
  }

  .year {
    font-weight: normal;
    font-size: 1rem;
  }

  .columns {
    display: flex;
    gap: 1rem;
  }

  .subtitle {
    font-weight: bold;
  }
</style>
