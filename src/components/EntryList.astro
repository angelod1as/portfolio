---
import { tagSlug, type Entry } from '../lib/entries'

interface Props {
  entries: Entry[]
  // Lane indexes already say which lane they are; tag pages and the archive do not.
  showLane?: boolean
  // Indexes put these directly under the <h1>; the homepage nests them under a
  // per-lane <h2>. Skipping a level is a scored accessibility failure.
  headingLevel?: 2 | 3
}

const { entries, showLane = false, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3'

const LANG_LABEL = { en: 'English', pt: 'Português' } as const
---

{
  entries.length === 0 ? (
    <p>Nothing here yet.</p>
  ) : (
    <ul>
      {entries.map(entry => (
        <li>
          <article>
            <Heading>
              <a href={entry.address}>{entry.data.title}</a>
            </Heading>
            <p>
              <time datetime={entry.data.date.toISOString()}>
                {entry.data.date.toISOString().slice(0, 10)}
              </time>
              <span> · </span>
              <span lang={entry.data.lang}>{LANG_LABEL[entry.data.lang]}</span>
              {showLane && (
                <>
                  <span> · </span>
                  <span>{entry.lane}</span>
                </>
              )}
            </p>
            {entry.data.tags.length > 0 && (
              <ul aria-label="Tags">
                {entry.data.tags.map(tag => (
                  <li>
                    <a href={`/tags/${tagSlug(tag)}`}>{tag}</a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ul>
  )
}
