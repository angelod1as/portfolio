---
import { formatDate } from "../utils/date";
import Pill from "./Pill.astro";

type Props = {
  url: string;
  title: string;
  date: Date;
  description?: string;
  draft?: boolean;
  categories?: string[];
  kind?: string[];
};

const { url, title, date, description, draft, categories, kind } = Astro.props;

const isoDate = date.toISOString();
const shortDate = formatDate(date, { short: true });
---

<li data-cat={categories?.join(" ")} data-kind={kind?.join(" ")}>
  <a href={url}>
    <time datetime={isoDate}>{shortDate}</time> - {title}
  </a>
  {draft && <Pill class="draft-pill">DRAFT</Pill>}
  {
    categories && categories.length > 0 && (
      <ul class="categories">
        {categories.map((category) => (
          <li>
            <Pill variant="outline">{category}</Pill>
          </li>
        ))}
      </ul>
    )
  }
  {description && <p class="description">{description}</p>}
</li>

<style>
  li + li {
    margin-top: 1rem;
  }

  time {
    font-style: italic;
    color: var(--muted);
  }

  .description {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .categories {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-left: 0;
    margin-inline-start: 1rem;
    vertical-align: baseline;
    text-transform: lowercase;

    li + li {
      margin-top: 0;
    }

    li::before {
      content: "";
      width: 0;
      margin-left: 0;
    }
  }
</style>
