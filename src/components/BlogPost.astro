---
import { formatDate } from "../utils/date";
import Pill from "./Pill.astro";

type Props = {
  url: string;
  title: string;
  date: Date;
  description?: string;
  draft?: boolean;
};

const { url, title, date, description, draft } = Astro.props;

const isoDate = date.toISOString();
const shortDate = formatDate(date, { short: true });
---

<li>
  <a href={url}>
    <time datetime={isoDate}>{shortDate}</time> - {title}
  </a>
  {draft && <Pill>DRAFT</Pill>}
  {description && <p class="description">{description}</p>}
</li>

<style>
  li + li {
    margin-top: 1rem;
  }

  time {
    font-style: italic;
    color: var(--muted);
  }

  .description {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
