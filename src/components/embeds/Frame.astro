---
type Props = {
  title: string;
  src: string;
  ratio?: string;
  height?: string;
  allow?: string;
};

const { title, src, ratio = "16 / 9", height, allow } = Astro.props;

const box = height ? `height: ${height}` : `aspect-ratio: ${ratio}`;
---

<div class="frame" style={box}>
  <iframe
    src={src}
    title={title}
    allow={allow}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg);
    border-radius: 15px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
