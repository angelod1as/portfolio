---
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="wrapper">
  <ThemeToggle />
  <h1>I am <span>angelo</span><br />and I do <i>stuff</i></h1>
  <Navigation />
</div>

<style>
  .wrapper {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;

    h1 {
      margin: 0;
    }
  }
</style>
