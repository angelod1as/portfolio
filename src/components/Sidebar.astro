---
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";

const titles = {
  blog: "blogging",
  projects: "projects",
  more: "even more!",
};

const url = Astro.url.pathname.replaceAll("/", "");
const titleString = titles[url as keyof typeof titles] || "stuff";
---

<div class="wrapper">
  <ThemeToggle />
  <p class="title">
    I am <span>angelo</span><br />and I do <i>{titleString}</i>
  </p>
  <Navigation />
</div>

<style>
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 100%;
    margin: 0;
    font-size: 2.5rem;
  }
  .wrapper {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;

    h1 {
      margin: 0;
    }
  }
</style>
