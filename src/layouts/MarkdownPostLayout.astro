---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  frontmatter: CollectionEntry<"blog">["data"];
  blameUrl: string | null;
};

const { frontmatter, blameUrl } = Astro.props;
const { title, pubDate, description } = frontmatter;
const date = pubDate.toLocaleDateString();
---

<BaseLayout title={title}>
  <div class="header">
    <h1>{title}</h1>
    <p><em>{description}</em></p>
  </div>

  <slot />

  <div class="footer">
    <p>Written by Angelo Dias at {date}</p>
    {
      blameUrl && (
        <footer>
          <a href={blameUrl} target="_blank" rel="noopener">
            View revision history →
          </a>
        </footer>
      )
    }
  </div>
</BaseLayout>

<style>
  .pubdate {
    font-size:;
  }
</style>
