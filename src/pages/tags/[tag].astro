---
import Base from '../../layouts/Base.astro'
import EntryList from '../../components/EntryList.astro'
import { loadPublished } from '../../lib/content'
import { byTag, tagCounts, type Entry } from '../../lib/entries'

export async function getStaticPaths() {
  const all = await loadPublished()

  return tagCounts(all).map(({ tag }) => ({
    params: { tag },
    props: { entries: byTag(all, tag) },
  }))
}

const { tag } = Astro.params
const { entries } = Astro.props as { entries: Entry[] }
---

<Base title={`Tagged “${tag}”`} description={`Everything tagged ${tag}.`}>
  <h1>Tagged “{tag}”</h1>
  <p>
    <a href="/tags">All tags</a>
  </p>
  <EntryList entries={entries} showLane />
</Base>
