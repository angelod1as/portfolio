---
import Base from '../../layouts/Base.astro'
import EntryList from '../../components/EntryList.astro'
import { loadPublished } from '../../lib/content'
import { byTag, tagCounts, type Entry } from '../../lib/entries'

export async function getStaticPaths() {
  const all = await loadPublished()

  return tagCounts(all).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { entries: byTag(all, slug), label: tag },
  }))
}

// The URL carries the slug; the page shows the tag as Angelo wrote it.
const { entries, label } = Astro.props as { entries: Entry[]; label: string }
---

<Base title={`Tagged “${label}”`} description={`Everything tagged ${label}.`}>
  <h1>Tagged “{label}”</h1>
  <p>
    <a href="/tags">All tags</a>
  </p>
  <EntryList entries={entries} showLane />
</Base>
