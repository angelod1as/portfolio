---
import Base from '../../layouts/Base.astro'
import LangLinks from '../../components/LangLinks.astro'
import { loadLane } from '../../lib/content'
import { byLang, tagSlug } from '../../lib/entries'

const LANG_LABEL = { en: 'English', pt: 'Português' } as const

// One route builds every view: unfiltered, the two languages, and the three media.
const MEDIA = { books: 'book', series: 'series', films: 'film' } as const
type MediumSlug = keyof typeof MEDIA

export async function getStaticPaths() {
  return [undefined, 'en', 'pt', 'books', 'series', 'films'].map(filter => ({
    params: { filter },
  }))
}

const { filter } = Astro.params
const all = await loadLane('library')

const isLang = filter === 'en' || filter === 'pt'
const isMedium = filter !== undefined && filter in MEDIA

const entries = isLang
  ? byLang(all, filter)
  : isMedium
    ? all.filter(
        entry =>
          (entry.data as { medium?: string }).medium ===
          MEDIA[filter as MediumSlug]
      )
    : all

const mediumViews: MediumSlug[] = ['books', 'series', 'films']
---

<Base
  title="Library"
  description="Books, series and films Angelo has finished, and what he thought of them."
>
  <h1>Library</h1>

  <LangLinks base="/library" current={isLang ? filter : undefined} />

  <nav aria-label="Medium">
    <ul>
      <li>
        {
          isMedium ? (
            <a href="/library">Everything</a>
          ) : (
            <span aria-current="true">Everything</span>
          )
        }
      </li>
      {
        mediumViews.map(slug => (
          <li>
            {filter === slug ? (
              <span aria-current="true">{slug}</span>
            ) : (
              <a href={`/library/${slug}`}>{slug}</a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  {
    entries.length === 0 ? (
      <p>Nothing here yet.</p>
    ) : (
      <ul>
        {entries.map(entry => {
          const data = entry.data as typeof entry.data & {
            medium: string
            by: string
          }
          return (
            <li>
              <article>
                <h2>
                  <a href={entry.address}>{data.title}</a>
                </h2>
                <p>
                  <span>{data.medium}</span>
                  <span> · </span>
                  <span>{data.by}</span>
                  <span> · </span>
                  <time datetime={data.date.toISOString()}>
                    {data.date.toISOString().slice(0, 10)}
                  </time>
                  <span> · </span>
                  <span lang={data.lang}>{LANG_LABEL[data.lang]}</span>
                </p>
                {data.tags.length > 0 && (
                  <ul aria-label="Tags">
                    {data.tags.map(tag => (
                      <li>
                        <a href={`/tags/${tagSlug(tag)}`}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          )
        })}
      </ul>
    )
  }
</Base>
