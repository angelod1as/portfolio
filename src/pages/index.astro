---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import SmallProjectCard from "../components/SmallProjectCard.astro";
import Opening from "../fragments/index/opening.md";
import "../styles/global.css";

const sorter = (a: any, b: any) => {
  const aTime = a.data.pubDate.getTime();
  const bTime = b.data.pubDate.getTime();
  return aTime - bTime;
};
const allPosts = (await getCollection("blog")).sort(sorter).slice(0, 5);
const allProjects = (await getCollection("projects")).sort(sorter).slice(0, 3);
---

<BaseLayout>
  <div class="wrapper">
    <div class="test">
      <Opening />
    </div>
    <div class="projects full">
      <h2>Latest in projects</h2>
      <ul class="projects">
        {allProjects.map((project) => <SmallProjectCard project={project} />)}
      </ul>
    </div>
    <div>
      <h2>Latest in writing</h2>
      <ul>
        {
          allPosts.map((post) => (
            <BlogPost url={`/posts/${post.id}`} title={post.data.title} />
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;

    > * {
      grid-column: 1;
    }

    > .full {
      grid-column: 1 / -1;
    }
  }

  .projects ul {
    padding: 0;
    margin: 0;
  }
</style>
