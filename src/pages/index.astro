---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import CardList from "../components/CardList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Opening from "../fragments/index/opening.md";
import "../styles/global.css";
import { byDate, byHighlighted, splitHighlighted } from "../utils/sort";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort(byDate)
  .slice(0, 5);

const recommendations = (await getCollection("recommendations"))
  .filter((r) => r.data.highlighted)
  .sort(byHighlighted)
  .slice(0, 3);

const { highlighted, rest } = splitHighlighted(await getCollection("projects"));
const allProjects = [...highlighted, ...rest].slice(0, 3);
---

<BaseLayout>
  <div class="wrapper">
    <div class="prose">
      <Opening />
    </div>
    <div class="prose full">
      <h2>Latest in projects</h2>
      <CardList gap="1rem">
        {
          allProjects.map((project) => (
            <li>
              <ProjectCard project={project} variant="compact" />
            </li>
          ))
        }
      </CardList>
    </div>
    <div>
      <h2 class="subtitle">Latest in writing</h2>
      <ul>
        {
          allPosts.map((post) => (
            <BlogPost
              url={`/blog/${post.id}`}
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
            />
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="subtitle">Recommendation highlights</h2>
      <ul class="recommendations">
        {
          recommendations.map((rec) => (
            <li>
              <blockquote>{rec.data.excerpt}</blockquote>
              <p class="who">
                {rec.data.name} — {rec.data.role} @ {rec.data.company}
              </p>
            </li>
          ))
        }
      </ul>
      <p><a href="/recommendations/">See all recommendations →</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;

    > * {
      grid-column: 1;
    }

    > .full {
      grid-column: 1 / -1;
    }
  }

  .subtitle {
    margin-bottom: 1rem;
  }

  .recommendations {
    padding-left: 0;

    li::before {
      content: none;
      width: 0;
      margin-left: 0;
    }

    li + li {
      margin-top: 1.5rem;
    }

    .who {
      margin-top: 0.4rem;
      font-size: 0.9rem;
      color: var(--muted);
    }
  }
</style>
