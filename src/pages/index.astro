---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import CardList from "../components/CardList.astro";
import SmallProjectCard from "../components/SmallProjectCard.astro";
import Opening from "../fragments/index/opening.md";
import "../styles/global.css";
import { byPubDate, splitHighlighted } from "../utils/sort";

const allPosts = (await getCollection("blog")).sort(byPubDate).slice(0, 5);

const { highlighted, rest } = splitHighlighted(await getCollection("projects"));
const allProjects = [...highlighted, ...rest].slice(0, 3);
---

<BaseLayout>
  <div class="wrapper">
    <div class="prose">
      <Opening />
    </div>
    <div class="prose full">
      <h2>Latest in projects</h2>
      <CardList gap="1rem">
        {
          allProjects.map((project) => (
            <li>
              <SmallProjectCard project={project} />
            </li>
          ))
        }
      </CardList>
    </div>
    <div>
      <h2 class="subtitle">Latest in writing</h2>
      <ul>
        {
          allPosts.map((post) => (
            <BlogPost url={`/posts/${post.id}`} title={post.data.title} />
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;

    > * {
      grid-column: 1;
    }

    > .full {
      grid-column: 1 / -1;
    }
  }

  .subtitle {
    margin-bottom: 1rem;
  }
</style>
