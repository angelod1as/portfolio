---
import type { InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'
import EntryLayout from '../../../layouts/Entry.astro'
import { loadPublished } from '../../../lib/content'

export async function getStaticPaths() {
  const entries = await loadPublished()

  return entries.map(entry => {
    const [, year, month, slug] = entry.address.split('/')
    return { params: { year, month, slug }, props: { entry } }
  })
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { entry } = Astro.props
// `entry.raw` is the untouched collection entry, so this needs no cast.
const { Content } = await render(entry.raw)
---

<EntryLayout entry={entry}>
  <Content />
</EntryLayout>
