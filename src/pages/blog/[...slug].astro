---
import { YouTube } from "@astro-community/astro-embed-youtube";
import { getCollection, render } from "astro:content";
import OldPostNotice from "../../components/OldPostNotice.astro";
import Pill from "../../components/Pill.astro";
import Parenthesis from "../../components/mdx/Parenthesis.astro";
import ProseLayout from "../../layouts/ProseLayout.astro";
import { formatDate, isOld } from "../../utils/date";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const REPO_URL = "https://github.com/angelod1as/portfolio";
const REPO_BRANCH = "main";

const historyUrl = post.filePath
  ? `${REPO_URL}/commits/${REPO_BRANCH}/${post.filePath}`
  : null;

const { date } = post.data;
const isoDate = date.toISOString();
const formattedDate = formatDate(date);
const isOldPost = isOld(date);
---

<ProseLayout title={post.data.title} description={post.data.description}>
  <p slot="meta" class="meta">
    <time datetime={isoDate}>{formattedDate}</time> · Written by Angelo Dias
    {post.data.draft && <Pill>DRAFT</Pill>}
  </p>

  {isOldPost && <OldPostNotice />}

  <Content components={{ Parenthesis, YouTube }} />

  <div slot="footer" class="footer">
    {
      historyUrl && (
        <a
          href={historyUrl}
          class="external-link"
          rel="noopener noreferrer"
          target="_blank"
        >
          View revision history<span> ➹</span>
        </a>
      )
    }
  </div>
</ProseLayout>

<style>
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    font-style: normal;
  }
</style>
