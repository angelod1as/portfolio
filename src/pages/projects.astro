---
import { getCollection } from "astro:content";
import CardList from "../components/CardList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProseLayout from "../layouts/ProseLayout.astro";
import { splitHighlighted } from "../utils/sort";

const { highlighted, rest } = splitHighlighted(await getCollection("projects"));
---

<ProseLayout
  title="Projects"
  description="Below, a list of projects — still WIP"
>
  <p class="wip">Planned: additive filters using query parameters</p>

  {
    highlighted.length > 0 && (
      <>
        <h2>Highlighted</h2>
        <CardList>
          {highlighted.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </CardList>
      </>
    )
  }

  <h2>All projects</h2>
  <CardList>
    {rest.map((project) => <ProjectCard project={project} />)}
  </CardList>
</ProseLayout>
