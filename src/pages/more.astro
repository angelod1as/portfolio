---
import Colophon from "../fragments/more/colophon.md";
import Experience from "../fragments/more/experience.md";
import IAm from "../fragments/more/i-am.md";
import IWant from "../fragments/more/i-want.md";
import IWas from "../fragments/more/i-was.md";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const title = "I am angelo and here's more";
---

<BaseLayout title={title}>
  <div class="wrapper">
    <div class="more prose"><IAm /></div>
    <div class="more prose"><IWant /></div>
    <div class="more prose"><IWas /></div>
    <div class="experience prose"><Experience /></div>
    <div class="more prose"><Colophon /></div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .experience {
    h3 {
      margin: 0.5rem 0;
    }
    span {
      display: block;
      margin: 2rem 0 0.3rem 0;
      color: var(--muted);
      font-size: 0.9rem;
      font-style: italic;
    }
  }
  .more {
    h2 {
      margin-bottom: 1rem;
    }
  }
</style>
