---
import { YouTube } from "@astro-community/astro-embed-youtube";
import { getCollection, render } from "astro:content";
import Audio from "../../components/embeds/Audio.astro";
import Book from "../../components/embeds/Book.astro";
import Podcast from "../../components/embeds/Podcast.astro";
import ProseLayout from "../../layouts/ProseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ProseLayout title={project.data.title} description={project.data.description}>
  {
    project.data.live && (
      <a
        href={project.data.live}
        class="external-link see-it-live"
        target="_blank"
        rel="noopener noreferrer"
      >
        See it live<span> ➹</span>
      </a>
    )
  }

  <Content components={{ YouTube, Podcast, Book, Audio }} />
</ProseLayout>

<style>
  .see-it-live {
    display: block;
    margin: 1rem 0;
  }
</style>
